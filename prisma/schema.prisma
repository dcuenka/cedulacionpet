generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (Neon / Vercel Postgres). Para desarrollo local usa la misma
// cadena de Neon, o una rama de desarrollo del proyecto en Neon.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Ficha de registro de un animal de compañía (Formulario de Registro petdulación).
model PetRecord {
  id             String  @id @default(cuid())
  // Número de ficha interno del sistema, ej: PET-2026-000123
  registrationNo String  @unique
  // Números impresos en el formulario físico.
  certificateNo  String? // Certificado N°
  qrCode         String? @unique // Código QR N° (tarjeta/etiqueta física)
  microchip      String? @unique // Microchip N° (leído con el lector)

  // --- Información del animalito de compañía ---
  petName           String
  species           String // Especie
  breed             String? // Raza
  birthDate         DateTime?
  sex               String // Macho, Hembra
  color             String?
  distinctiveMarks  String? // señas particulares (manchas, cicatrices) para identificación
  sterilized        Boolean  @default(false) // Esterilizado
  training          Boolean  @default(false) // Adiestramiento
  aggressionHistory Boolean  @default(false) // Antecedentes de agresión
  feeding           String? // Alimentación: Balanceado | Casera | Mixta
  lastVaccineDate   DateTime? // Fecha última vacuna
  nextVaccineDate   DateTime? // Próxima vacuna
  vaccines          String? // Vacunas aplicadas (texto)
  lastDewormDate    DateTime? // Última desparasitación
  nextDewormDate    DateTime? // Próxima desparasitación
  diseases          String? // Enfermedades
  photoData         String? // foto en base64 (data URL)

  // --- Información del tutor responsable ---
  ownerName     String
  ownerIdType   String  @default("Cédula")
  ownerId       String // Cédula
  ownerPhone    String? // Teléfono 1
  ownerPhoneAlt String? // Teléfono 2
  ownerEmail    String?
  ownerAddress  String? // Dirección
  province      String?
  city          String?

  // --- Datos internos ---
  // Firma visual (color/patrón) de la foto, para la búsqueda por parecido.
  embedding  Json?
  mvz        String? // Médico veterinario (MVZ) responsable
  clientType String   @default("interno") // interno | externo
  status     String   @default("activo") // activo | anulado
  lost       Boolean  @default(false)
  notes      String?

  // Módulos activados para que el tutor los vea en su carnet digital.
  showCedula   Boolean @default(true)
  showCarnet   Boolean @default(true)
  showHistoria Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  healthEvents    HealthEvent[]
  photos          PetPhoto[]
  prescriptions   Prescription[]
  clinicalEntries ClinicalEntry[]

  @@index([ownerId])
  @@index([microchip])
  @@index([createdAt])
}

// Evento de salud aplicado en una visita (vacuna o desparasitación).
// Es el historial del carnet: una fila por cada proceso realizado.
model HealthEvent {
  id          String    @id @default(cuid())
  petRecordId String
  pet         PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)

  type      String // "vacuna" | "desparasitacion"
  product   String? // nombre de la vacuna / producto
  date      DateTime // fecha en que se aplicó
  nextDate  DateTime? // próxima dosis / refuerzo
  weight    String? // peso de la mascota al momento (ej. "15" kg)
  lot       String? // lote del producto
  mvz       String? // médico veterinario que lo aplicó (firma)
  photoData String? // foto de la etiqueta/carnet (base64), opcional
  notes     String?
  // "validado" = registrado/confirmado por el equipo (oficial).
  // "pendiente" = reportado por el tutor, a la espera de validación.
  status    String   @default("validado")
  source    String   @default("admin") // "admin" | "tutor"
  createdAt DateTime  @default(now())

  @@index([petRecordId])
  @@index([status])
  @@index([date])
}

// Archivo fotográfico de la mascota: fotos de respaldo que el tutor y el
// equipo pueden consultar en la aplicación (documentos, exámenes, la mascota).
model PetPhoto {
  id          String    @id @default(cuid())
  petRecordId String
  pet         PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)

  photoData String // imagen en base64 (data URL)
  caption   String? // descripción opcional
  // "album" = archivo general. Para el estudio biométrico: "bio-frente",
  // "bio-perfil-izq", "bio-perfil-der", "bio-nariz", "bio-cuerpo".
  kind      String   @default("album")
  createdAt DateTime @default(now())

  @@index([petRecordId])
  @@index([kind])
}

// Archivo de recetas: el tutor fotografía la receta médica y queda el
// historial gráfico de lo que le recetaron en cada visita.
model Prescription {
  id          String    @id @default(cuid())
  petRecordId String
  pet         PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)

  photoData String // foto de la receta (base64)
  note      String? // detalle / observaciones opcionales
  date      DateTime  @default(now()) // fecha de la receta
  source    String    @default("tutor") // tutor | admin
  createdAt DateTime  @default(now())

  @@index([petRecordId])
  @@index([date])
}

// Historia clínica: consultas / atenciones veterinarias de la mascota.
model ClinicalEntry {
  id          String    @id @default(cuid())
  petRecordId String
  pet         PetRecord @relation(fields: [petRecordId], references: [id], onDelete: Cascade)

  date      DateTime // fecha de la atención
  weight    String? // peso
  reason    String? // motivo de consulta
  diagnosis String? // diagnóstico
  treatment String? // tratamiento
  notes     String? // observaciones
  mvz       String? // médico veterinario
  createdAt DateTime  @default(now())

  @@index([petRecordId])
  @@index([date])
}

// Reporte de hallazgo: alguien encontró una mascota y sube su foto para que
// el equipo la verifique internamente (coincidencias por parecido) y responda.
model FoundReport {
  id        String   @id @default(cuid())
  photoData String // foto de la mascota encontrada (base64)
  phone     String? // contacto de quien la encontró (opcional)
  note      String? // dónde/cómo la encontró (opcional)
  status    String   @default("nueva") // nueva | revisada | descartada
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Solicitud de servicio: personas nuevas / de otras provincias que piden el
// servicio desde el formulario público. El equipo las contacta y atiende.
model ServiceRequest {
  id        String @id @default(cuid())

  // Tutor / solicitante
  ownerName     String // nombre completo
  ownerId       String? // cédula (opcional)
  phone         String // teléfono / WhatsApp
  phoneAlt      String? // teléfono adicional
  email         String?
  province      String // provincia del Ecuador
  city          String?
  address       String?

  // Mascota
  petName   String?
  species   String?
  breed     String?
  sex               String?
  color             String?
  birthDate         DateTime?
  microchip         String? // número de serie del microchip (si lo tiene)
  hasChip           Boolean   @default(false)
  distinctiveMarks  String? // señas particulares
  sterilized        Boolean   @default(false)
  training          Boolean   @default(false)
  aggressionHistory Boolean   @default(false)
  feeding           String? // Balanceado | Casera | Mixta
  diseases          String? // enfermedades / notas de salud

  // Fotos para actualización de datos (base64)
  petPhoto     String? // foto de la mascota
  carnetPhoto  String? // foto del carnet de vacunas
  paymentPhoto String? // comprobante del pago realizado

  // Estudio biométrico para reconocimiento / recuperación (base64)
  bioFront String? // frente
  bioNose  String? // nariz / trufa
  bioRight String? // lado derecho
  bioLeft  String? // lado izquierdo
  bioMark  String? // rasgo distintivo

  message String? // qué necesita / cómo se enteró
  status  String  @default("nueva") // nueva | contactado | atendida | descartada
  notes   String? // notas internas del equipo

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
